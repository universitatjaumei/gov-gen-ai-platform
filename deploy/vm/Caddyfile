# Caddyfile de la VM (D.4-VM). Se copia a /opt/govgenai/Caddyfile.
#
# Caddy y no nginx por una razón concreta: obtiene y renueva el certificado solo, sin cron ni
# ceremonia. En el prototipo `GOVGENAI_HOST` es un nombre de `sslip.io` —que resuelve a la IP
# de la VM y para el que Let's Encrypt emite con normalidad— y mañana será el subdominio
# institucional. Cambiarlo es una variable de entorno, no editar este fichero.
#
# Un nombre hace falta aunque las páginas del corpus vivan en un bucket: se sirven por HTTPS, y
# desde una página HTTPS el navegador **bloquea** una llamada a `http://IP`; con `https://IP` no
# hay certificado posible, porque Let's Encrypt no emite para direcciones IP desnudas.
#
# ── Dos nombres a la vez, y por qué (D.8, 2026-09-01) ────────────────────────────────────────
#
# Desde que existe el dominio institucional hay **dos** sitios: el nombre provisional de
# `sslip.io` que llega por `GOVGENAI_HOST` (certificado de Let's Encrypt, automático) y
# `normativa.uji.es` con su certificado propio de HARICA, que se instala en `sites.d/`.
#
# No se sustituye uno por otro de golpe porque **las 313 páginas del corpus ya publicadas en el
# bucket llevan el nombre provisional dentro** (`data-api-url` del widget): cambiar el host sin
# regenerarlas y volver a subirlas deja el asistente muerto en todas. Sirviendo los dos, la
# transición no tiene ventana de caída, y el provisional se retira cuando las páginas apunten al
# definitivo.
#
# Las rutas van en un fragmento y no copiadas en cada bloque: dos copias divergen: la primera
# versión de este fichero ya demostró lo que pasa cuando la misma cosa se dice en dos sitios.
#
# ── El reparto, y por qué cambió (DOM.1, 2026-09-02) ─────────────────────────────────────────
#
# Hasta hoy este fragmento mandaba al panel todo lo que no fuera API ni salud. El día que
# apareció el registro A de `normativa.uji.es`, eso significó que lo primero que servía el
# dominio institucional era **el login**. El reparto de ahora:
#
#   /                          la portada pública del corpus (el bucket)
#   /cercador, /gerencia       las dos direcciones cortas de los cercadores
#   /html/…, /pdf/…, /img/…    el sitio del corpus, con la forma de sus URL intacta
#   /api/*, /health            la aplicación
#   /panel, /panel/*           el panel de gestión, y su login
#
# **Un solo fragmento para los dos nombres, y no es sólo economía**: `base` es de tiempo de
# compilación, así que la imagen del frontend referencia `/panel/assets/…` sea quien la sirva.
# Servir el panel en la raíz de un nombre y bajo prefijo en el otro pediría dos imágenes.

(govgenai_rutas) {
	encode zstd gzip

	# La API. El prefijo se conserva: el widget incrustado en el bucket llama a
	# https://<host>/api/v1/... y el servidor espera esa ruta.
	handle /api/* {
		reverse_proxy app:8000
	}

	# Comprobación de salud, sin pasar por el frontend.
	handle /health {
		reverse_proxy app:8000
	}

	# El panel de gestión, y con él el login. **Sin despojar el prefijo**: lo sirve el nginx
	# de la propia imagen en `/panel/`, así que el contenedor se comporta igual abierto
	# directo que detrás de este proxy. Un `handle_path` que lo quitara por delante dejaría
	# la imagen sirviendo en la raíz mientras su HTML pide `/panel/assets/…`, y eso sólo
	# funciona con el proxy puesto.
	#
	# Las dos rutas van en un matcher con nombre porque `handle` acepta **un solo**
	# argumento: `handle /panel /panel/*` no es un reparto más estricto, es un error de
	# sintaxis que impide arrancar. `/panel` a secas es para quien escriba la dirección
	# corta —nginx la redirige a `/panel/`— y el comodín, para las rutas de la aplicación y
	# sus recursos.
	@panel path /panel /panel/*
	handle @panel {
		reverse_proxy frontend:8080
	}

	# El MCP remoto (REG.4). **Sin despojar el prefijo**: el SDK sirve el transporte en
	# `/mcp`, así que el contenedor se comporta igual abierto directo que detrás de este
	# proxy — el mismo criterio que el panel, y por el mismo motivo.
	#
	# Dos rutas con matcher con nombre porque `handle` acepta un solo argumento. Y sin
	# `flush_interval`: el transporte se configura con respuestas JSON en vez de SSE
	# precisamente para no depender de que alguien se acuerde de desactivar el buffering
	# del proxy.
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy mcp:8080
	}

	# Todo lo demás, el sitio del corpus publicado en el bucket.
	handle {
		# La raíz del bucket **no** es su `index.html`: devuelve 200 con `ListBucketResult`,
		# el inventario de todos sus objetos. GCS sólo mapea `/` a `index.html` con la
		# configuración de *sitio web*, y eso exige el balanceador HTTPS que este bloque
		# evitó a propósito (18-25 €/mes). Así que se reescribe aquí.
		rewrite / /index.html

		# Las dos direcciones que la gente escribe y comparte. Redirección y no copia: la
		# página canónica sigue siendo una sola, y los enlaces relativos de dentro del sitio
		# (cercador→ficha, ficha→PDF) siguen resolviendo desde su ruta de siempre.
		redir /cercador /cercador.html permanent
		redir /gerencia /cercador_gerencia.html permanent

		# Forma **virtual-hosted** y `Host` reescrito. Las dos cosas importan: la otra forma
		# (`storage.googleapis.com/<bucket>/…`) comparte origen con todos los buckets del
		# mundo, y sin reescribir `Host` GCS recibe `normativa.uji.es` y no sabe a qué bucket
		# se refiere — 404 en todo el sitio, incluidas las 313 fichas que cita el asistente.
		#
		# El nombre llega por entorno: el mismo mecanismo tiene que servir a otra
		# organización con otro bucket.
		reverse_proxy https://{$CORPUS_BUCKET}.storage.googleapis.com {
			header_up Host {upstream_hostport}
		}
	}

	# `/docs` no se abre aquí a propósito: SEC.7 lo apaga en producción desde la propia
	# aplicación, y duplicar la regla en el proxy daría la impresión de que la protección es
	# del proxy. Si algún día el proxy dejara de estar, la aplicación sigue cerrada.

	# **Las cabeceras de seguridad NO se ponen aquí.** Las pone la aplicación
	# (`server/app/core/security_headers.py`): `X-Content-Type-Options`, `X-Frame-Options: DENY`,
	# `Referrer-Policy`, CSP y —sólo en producción— HSTS. Repetirlas en el proxy crearía dos
	# fuentes de verdad para la misma cabecera, y la primera versión de este fichero ya lo
	# demostró: escribí `SAMEORIGIN` donde la aplicación dice `DENY`, o sea que la copia del
	# proxy era la débil. Si algún día el proxy desaparece, la protección sigue puesta.
	header {
		-Server
	}

	log {
		output stdout
		format json
	}
}

# El nombre provisional, que es el que llevan dentro las páginas ya publicadas.
{$GOVGENAI_HOST} {
	import govgenai_rutas
}

# Los sitios con certificado propio. **Glob a propósito**: `import` de un fichero concreto falla
# si no está y Caddy no arranca —y un Caddy que no arranca se lleva por delante también el host
# provisional—, mientras un glob que no casa nada es válido. Así esta configuración se puede
# desplegar antes de que el dominio institucional exista en el DNS, que es exactamente la
# situación del 2026-09-01.
#
# Quien escribe ahí dentro es `scripts/vm_fetch_tls.sh`, y sólo si el certificado y la clave se
# han bajado de Secret Manager.
import /etc/caddy/sites.d/*.caddy
