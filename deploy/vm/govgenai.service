# Unidad systemd de la VM (D.4-VM). Se copia a /etc/systemd/system/govgenai.service
# y se habilita con `systemctl enable govgenai`.
#
# Esto es la avería que una VM tiene y un servicio gestionado no: si la máquina se reinicia
# —mantenimiento de GCP, un `reboot` por un parche de kernel— nadie levanta los contenedores.
# Sin esta unidad, el sistema se queda apagado hasta que alguien entra a mano, y la primera
# noticia la da un usuario.
#
# Antes de levantar nada baja los secretos: el fichero de entorno se reconstruye en cada
# arranque desde Secret Manager, así que rotar una credencial es cambiar el secreto y
# reiniciar. Si `vm_fetch_secrets.sh` falla, la unidad NO arranca la pila — arrancar con
# media configuración es peor que no arrancar.

[Unit]
Description=Gov Gen AI Platform (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/govgenai
EnvironmentFile=/opt/govgenai/.env.despliegue

# Sockets huérfanos del Cloud SQL Auth Proxy. Si el contenedor muere sin apagarse bien —un
# `kill`, un reinicio duro, un OOM—, el fichero del socket se queda y el proxy siguiente no
# arranca: falla con «bind: address already in use», un mensaje que no dice que haya que borrar
# nada.
#
# **Sólo si no hay proxy corriendo**, y esa condición no es paranoia: la primera versión
# limpiaba sin comprobar, razonando que en un `restart` systemd ya ha ejecutado ExecStop. Pero
# ExecStop es el MISMO `docker compose`, así que cuando el fichero de entorno quedó a medias
# también falló, los contenedores siguieron vivos, y esta línea **borró el socket con el proxy
# funcionando**. El proxy siguió declarándose sano —ya estaba enlazado— y la aplicación no
# encontraba nada: `FileNotFoundError` al conectar. Una guarda que no comprueba puede causar el
# fallo que venía a evitar.
ExecStartPre=/bin/sh -c 'docker ps --filter name=govgenai_sql_proxy --filter status=running -q | grep -q . || find /opt/govgenai/cloudsql -mindepth 1 -maxdepth 1 -exec rm -rf {} +'

ExecStartPre=/opt/govgenai/scripts/vm_fetch_secrets.sh --project ${GOOGLE_CLOUD_PROJECT} --out /opt/govgenai/.env.runtime

# El certificado del dominio institucional y el sitio de Caddy que lo usa (D.8). Va DESPUÉS de
# los secretos y ANTES de levantar la pila, porque si Caddy arranca sin el fichero del sitio el
# dominio no se sirve hasta el reinicio siguiente.
#
# **Sale 0 aunque el certificado no esté**, a propósito: mientras el dominio no exista en el DNS
# no hay certificado que bajar, y fallar aquí impediría levantar todo lo demás. Lo que hace en
# ese caso es retirar el fichero del sitio, que es lo que evita que un `tls` roto impida arrancar.
ExecStartPre=/opt/govgenai/scripts/vm_fetch_tls.sh --project ${GOOGLE_CLOUD_PROJECT} --host ${GOVGENAI_HOST_INSTITUCIONAL}
ExecStart=/usr/bin/docker compose -f /opt/govgenai/docker-compose.vm.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f /opt/govgenai/docker-compose.vm.yml down

# `Restart=always` con `Type=oneshot` no reintenta el arranque; lo que mantiene los
# contenedores en pie es `restart: unless-stopped` en el compose, que es el mecanismo
# correcto para esto. Esta unidad existe para el ARRANQUE de la máquina y para poder
# `systemctl restart govgenai` con la recarga de secretos incluida.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
