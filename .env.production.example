# === Database (Producción) ===
POSTGRES_DB=govgenai_prod
POSTGRES_USER=govgenai_prod
POSTGRES_PASSWORD=<GENERAR_PASSWORD_SEGURO>
DATABASE_URL=postgresql+asyncpg://govgenai_prod:<PASSWORD>@postgres:5432/govgenai_prod
DATABASE_URL_SYNC=postgresql+psycopg2://govgenai_prod:<PASSWORD>@postgres:5432/govgenai_prod

# === LLM Providers ===
GOOGLE_API_KEY=<TU_GOOGLE_API_KEY>
OPENROUTER_API_KEY=<TU_OPENROUTER_API_KEY>

# === MinIO (Object Storage) ===
MINIO_ROOT_USER=<MINIO_USER_PRODUCCION>
MINIO_ROOT_PASSWORD=<GENERAR_PASSWORD_SEGURO>
# MINIO_ENDPOINT se configura automáticamente como "minio:9000" en docker-compose.prod.yml

# === Auth — generar con: openssl rand -hex 32 ===
JWT_SECRET_KEY=<GENERAR_SECRET_64_CHARS_MINIMO>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# === LangSmith (observabilidad, opcional) ===
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=<TU_LANGSMITH_KEY>
LANGCHAIN_PROJECT=govgenai-prod

# === App ===
ENVIRONMENT=production
LOG_LEVEL=INFO
AUTOMATIA_SIGNING_KEY=<CLAVE_RSA_PRIVADA_BASE64>
