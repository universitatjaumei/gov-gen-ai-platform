# === LLM Providers ===
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# === Database ===
POSTGRES_DB=govgenai
POSTGRES_USER=govgenai
POSTGRES_PASSWORD=govgenai_dev
DATABASE_URL=postgresql+asyncpg://govgenai:govgenai_dev@localhost:5432/govgenai
DATABASE_URL_SYNC=postgresql+psycopg2://govgenai:govgenai_dev@localhost:5432/govgenai

# === MinIO (Object Storage) ===
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev
MINIO_ENDPOINT=localhost:9000

# === App ===
SHOW_ADMIN_TAB=True
STORAGE_ROOT=./data

# === Signing Key (RSA) ===
AUTOMATIA_SIGNING_KEY=

# === JWT (servidor — también en server/.env) ===
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
